# Variables para las notificaciones push. Se suman a las que ya tienes en .env
# (DATABASE_URL, JWT_SECRET, JWT_REFRESH_SECRET, CORS_ORIGIN, SMTP_*, etc.).

# ---------- Firebase Cloud Messaging (envío de push) ----------
# Consola de Firebase → Configuración del proyecto → Cuentas de servicio →
# "Generar nueva clave privada". Del JSON descargado se copian estos tres campos.
# Es una credencial PRIVADA: solo en el .env del servidor, nunca en el frontend
# ni en el repositorio. Sin ellas, las notificaciones funcionan en la app pero
# no se envía push.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Entre comillas y con los saltos de línea escritos como \n, tal como viene en el JSON:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
